{
  "$defs": {
    "EnhancementCue": {
      "description": "章节视觉增强线索：供场景层按线索拆镜 / 绑定 additional_data。",
      "properties": {
        "type": {
          "default": "broll",
          "description": "broll=可拆镜画面；overlay=字幕/HUD/标题（不计入拆镜）；animation=特效字/UI动效；hard_event=接触事件线索",
          "enum": [
            "broll",
            "overlay",
            "animation",
            "hard_event"
          ],
          "title": "Type",
          "type": "string"
        },
        "description": {
          "description": "可成像的短描述：地点/材质/主体动作/机位意图，禁止只写氛围词",
          "title": "Description",
          "type": "string"
        },
        "timestamp_hint": {
          "default": "",
          "description": "章内相对时间，必填，如 0-3 / 8 / mid / late",
          "title": "Timestamp Hint",
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "title": "EnhancementCue",
      "type": "object"
    },
    "OutlineChapterArtifact": {
      "properties": {
        "id": {
          "description": "Stable chapter id, e.g. ch_0 / chapter_1",
          "title": "Id",
          "type": "string"
        },
        "order": {
          "description": "0-based chapter order",
          "title": "Order",
          "type": "integer"
        },
        "title": {
          "description": "Chapter title (short, punchy)",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "What happens in this chapter: conflict → turn → landing; not mood-only",
          "title": "Description",
          "type": "string"
        },
        "duration": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Seconds; required for video_driven (sum == total_duration). Audio_driven may omit.",
          "title": "Duration"
        },
        "audio_segment_indices": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Audio-driven only: which audio segment indices this chapter covers",
          "title": "Audio Segment Indices"
        },
        "enhancement_cues": {
          "description": "Optional overlay/broll/diagram hints for this chapter",
          "items": {
            "$ref": "#/$defs/EnhancementCue"
          },
          "title": "Enhancement Cues",
          "type": "array"
        }
      },
      "required": [
        "id",
        "order",
        "title",
        "description"
      ],
      "title": "OutlineChapterArtifact",
      "type": "object"
    }
  },
  "description": "Canonical on-disk outline contract (after Program stamps ids).",
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "artifact": {
      "const": "outline",
      "default": "outline",
      "title": "Artifact",
      "type": "string"
    },
    "story_outline_uuid": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Story Outline Uuid"
    },
    "thread_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thread Id"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "mode": {
      "default": "video_driven",
      "enum": [
        "video_driven",
        "audio_driven"
      ],
      "title": "Mode",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "theme": {
      "title": "Theme",
      "type": "string"
    },
    "description": {
      "title": "Description",
      "type": "string"
    },
    "key_message": {
      "title": "Key Message",
      "type": "string"
    },
    "total_duration": {
      "title": "Total Duration",
      "type": "integer"
    },
    "style_guide": {
      "title": "Style Guide",
      "type": "string"
    },
    "user_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "",
      "title": "User Message"
    },
    "chapters": {
      "items": {
        "$ref": "#/$defs/OutlineChapterArtifact"
      },
      "minItems": 1,
      "title": "Chapters",
      "type": "array"
    }
  },
  "required": [
    "title",
    "theme",
    "description",
    "key_message",
    "total_duration",
    "style_guide",
    "chapters"
  ],
  "title": "OutlineArtifact",
  "type": "object"
}
