{
  "$defs": {
    "VideoPromptDraft": {
      "properties": {
        "shot_number": {
          "description": "Must match storyboard/scene shot_number",
          "title": "Shot Number",
          "type": "integer"
        },
        "i2v_prompt": {
          "description": "Primary motion prompt (I2V or Seedance-style: opener, timecodes, says, bans)",
          "title": "I2V Prompt",
          "type": "string"
        },
        "t2v_prompt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional T2V/Seedance dual prompt when pipeline supports it",
          "title": "T2V Prompt"
        },
        "negative_prompt": {
          "default": "",
          "description": "Explicit bans: readable text, watermark, wrong identity, etc.",
          "title": "Negative Prompt",
          "type": "string"
        }
      },
      "required": [
        "shot_number",
        "i2v_prompt"
      ],
      "title": "VideoPromptDraft",
      "type": "object"
    }
  },
  "properties": {
    "prompts": {
      "description": "One prompt object per expected shot_number in this batch",
      "items": {
        "$ref": "#/$defs/VideoPromptDraft"
      },
      "minItems": 1,
      "title": "Prompts",
      "type": "array"
    },
    "style": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional batch style tag echoed from style_guide",
      "title": "Style"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "artifact": {
      "const": "video_prompts",
      "default": "video_prompts",
      "title": "Artifact",
      "type": "string"
    },
    "thread_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thread Id"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    }
  },
  "required": [
    "prompts"
  ],
  "title": "VideoArtifact",
  "type": "object"
}
