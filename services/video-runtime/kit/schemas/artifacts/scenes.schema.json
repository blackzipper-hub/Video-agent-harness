{
  "$defs": {
    "SceneDraft": {
      "properties": {
        "scene_number": {
          "description": "1-based scene number; storyboard shot_number equals this",
          "title": "Scene Number",
          "type": "integer"
        },
        "title": {
          "description": "Short scene title for UI",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "USER-FACING only: 1–3 dense visual sentences a viewer/director can picture (who/costume/prop/action/setting/framing). NEVER dump NARRATIVE_ROLE/DIALOGUE/BEATS/SUBJECT/CAMERA labels here — those belong in additional_data.",
          "title": "Description",
          "type": "string"
        },
        "duration": {
          "description": "Scene length in seconds",
          "title": "Duration",
          "type": "number"
        },
        "camera_angle": {
          "default": "",
          "description": "e.g. 平视 / 仰拍 / OTS",
          "title": "Camera Angle",
          "type": "string"
        },
        "character_action": {
          "default": "",
          "description": "Primary contact action summary (may mirror additional_data.subject_motion)",
          "title": "Character Action",
          "type": "string"
        },
        "visual_style": {
          "default": "",
          "description": "Local style note if differs from global",
          "title": "Visual Style",
          "type": "string"
        },
        "transition_style": {
          "default": "cut",
          "description": "cut|dissolve|fade… into next",
          "title": "Transition Style",
          "type": "string"
        },
        "is_bridge": {
          "default": false,
          "description": "True if connective/bridge scene",
          "title": "Is Bridge",
          "type": "boolean"
        },
        "character_ids": {
          "description": "Character ids present in this scene",
          "items": {
            "type": "string"
          },
          "title": "Character Ids",
          "type": "array"
        },
        "chapter_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Owning chapter id",
          "title": "Chapter Id"
        },
        "generation_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Only: normal | lipsync | empty_shot (never video/i2v)",
          "title": "Generation Mode"
        },
        "additional_data": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenePlanMeta"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Typed craft: script_section_id, narrative_role, dialogue, beats, subject/subject_motion/spatial, framing→, shot_language, overlays…"
        }
      },
      "required": [
        "scene_number",
        "title",
        "description",
        "duration"
      ],
      "title": "SceneDraft",
      "type": "object"
    },
    "ScenePlanMeta": {
      "additionalProperties": true,
      "description": "OM scene_plan row metadata (stored under additional_data for DB bridge).",
      "properties": {
        "script_section_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Bind to script.sections[].id (required for drama binding)",
          "title": "Script Section Id"
        },
        "narrative_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OM enum preferred: establish_context|introduce_subject|build_tension|deliver_payload|transition|emotional_beat|evidence|comparison|resolution|call_to_action",
          "title": "Narrative Role"
        },
        "information_role": {
          "default": "",
          "description": "What the viewer learns or feels from this scene",
          "title": "Information Role",
          "type": "string"
        },
        "shot_intent": {
          "default": "",
          "description": "WHY this shot exists in the video",
          "title": "Shot Intent",
          "type": "string"
        },
        "hero_moment": {
          "default": false,
          "description": "True if visual peak of the piece",
          "title": "Hero Moment",
          "type": "boolean"
        },
        "dialogue": {
          "default": "",
          "description": "Spoken lines / TTS / silence note for this scene; empty if pure picture",
          "title": "Dialogue",
          "type": "string"
        },
        "beats": {
          "description": "2–6 timed action beats, e.g. '0-2s: …', '2-4s: …'",
          "items": {
            "type": "string"
          },
          "title": "Beats",
          "type": "array"
        },
        "subject": {
          "default": "",
          "description": "Name + costume + prop anchors visible in frame",
          "title": "Subject",
          "type": "string"
        },
        "subject_motion": {
          "default": "",
          "description": "Contact/prop motion chain with → (拍/递/鞠躬…); not skirt-sway-only",
          "title": "Subject Motion",
          "type": "string"
        },
        "spatial": {
          "default": "",
          "description": "Shot size + FG/MG/BG + framing change, e.g. OTS → CU",
          "title": "Spatial",
          "type": "string"
        },
        "camera_notes": {
          "default": "",
          "description": "Lens/height/DoF/steadiness free-text; complements shot_language",
          "title": "Camera Notes",
          "type": "string"
        },
        "overlays": {
          "description": "Abstract overlay notes; never readable digits/letters",
          "items": {
            "type": "string"
          },
          "title": "Overlays",
          "type": "array"
        },
        "overlay_notes": {
          "default": "",
          "description": "Free-text overlay direction",
          "title": "Overlay Notes",
          "type": "string"
        },
        "framing": {
          "default": "",
          "description": "Framing with → for change, e.g. MCU → CU",
          "title": "Framing",
          "type": "string"
        },
        "movement": {
          "default": "",
          "description": "Camera/subject motion summary",
          "title": "Movement",
          "type": "string"
        },
        "shot_language": {
          "anyOf": [
            {
              "$ref": "#/$defs/ShotLanguage"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured cinematography vocab"
        },
        "texture_keywords": {
          "description": "Material/atmosphere keywords",
          "items": {
            "type": "string"
          },
          "title": "Texture Keywords",
          "type": "array"
        }
      },
      "title": "ScenePlanMeta",
      "type": "object"
    },
    "ShotLanguage": {
      "description": "OM shot_language — prefer OM enums; accept free-text for zh agents.",
      "properties": {
        "shot_size": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OM: extreme_wide|wide|medium_wide|medium|medium_close|close_up|extreme_close_up|over_shoulder|insert|establishing",
          "title": "Shot Size"
        },
        "camera_movement": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OM: static|pan_*|tilt_*|dolly_*|tracking_*|crane_*|handheld|steadicam|whip_pan|orbital|zoom_*|rack_focus",
          "title": "Camera Movement"
        },
        "lens_mm": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Prefer 14|24|35|50|85|135|200",
          "title": "Lens Mm"
        },
        "lighting_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "OM: high_key|low_key|natural|golden_hour|blue_hour|tungsten_warm|neon|silhouette|rim_lit|volumetric|overcast_soft",
          "title": "Lighting Key"
        },
        "depth_of_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "shallow|medium|deep",
          "title": "Depth Of Field"
        },
        "color_temperature": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "cool|neutral|warm|mixed",
          "title": "Color Temperature"
        }
      },
      "title": "ShotLanguage",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "version": {
      "default": "1.0",
      "title": "Version",
      "type": "string"
    },
    "artifact": {
      "const": "scenes",
      "default": "scenes",
      "title": "Artifact",
      "type": "string"
    },
    "thread_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Thread Id"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "chapter_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Chapter Id"
    },
    "style_playbook": {
      "default": "",
      "title": "Style Playbook",
      "type": "string"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/SceneDraft"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "scenes"
  ],
  "title": "ScenesArtifact",
  "type": "object"
}
