{
  "version": 1,
  "upstream": "https://github.com/calesthio/OpenMontage",
  "callable": {
    "video_trimmer": {
      "capability": "video_post",
      "bridge": ["media.trim", "media.speed_adjust", "media.concat"],
      "operations": ["cut", "speed", "concat"],
      "limits": "cut only from t=0 to target_duration; arbitrary start/end not supported by Cuti Media"
    },
    "video_stitch": {
      "capability": "video_post",
      "bridge": ["media.concat"],
      "operations": ["stitch"],
      "limits": "transition must be cut; crossfade/spatial layouts filtered"
    },
    "frame_sampler": {
      "capability": "analysis",
      "bridge": ["media.extract_frame"],
      "operations": ["timestamps"],
      "limits": "interval/count/scene_guided strategies filtered"
    },
    "seedance_video": {
      "capability": "video_generation",
      "bridge": ["provider.generate", "api.provider.generate"],
      "operations": ["text_to_video", "image_to_video"],
      "limits": "uses Cuti Ark→WaveSpeed bridge; fal.ai FAL_KEY path not used"
    },
    "video_selector": {
      "capability": "video_generation",
      "bridge": ["provider.generate", "api.provider.generate"],
      "operations": ["select_and_generate"],
      "limits": "routes to Cuti provider bridge only"
    }
  },
  "filtered": {
    "remotion_*": "Node Remotion runtime not in Cuti",
    "hyperframes_compose": "HyperFrames runtime not in Cuti",
    "whisperx": "Local STT/GPU not shipped",
    "lip_sync": "Avatar GPU / third-party lip-sync not wired",
    "talking_head": "Avatar pipeline not in product",
    "kling_avatar": "Third-party avatar API not configured",
    "comfyui_video": "ComfyUI worker absent",
    "comfyui_image": "ComfyUI worker absent",
    "ltx_video_local": "Local GPU worker absent",
    "pexels_video": "Stock API / policy not enabled",
    "pixabay_video": "Stock API / policy not enabled",
    "tts_selector": "Use Cuti audio/music capabilities instead",
    "music_gen": "Use Cuti music.generate instead",
    "upscale": "Enhancement models not in Media",
    "face_restore": "Enhancement models not in Media",
    "bg_remove": "Enhancement models not in Media",
    "scene_detect": "Analysis host capability missing",
    "video_understand": "Analysis host capability missing",
    "sora_video": "Prompting kept; execute via provider.generate",
    "veo_video": "Prompting kept; execute via provider.generate",
    "kling_video": "Prompting kept; execute via provider.generate"
  }
}
