# Cuti-VideoAgent 环境变量示例 —— 复制为 .env.development / .env.production 并填入真实值。
# 切勿把含真实密钥的 .env.* 提交到开源仓库。

# ==================== 运行环境 ====================
ENVIRONMENT=development          # local / development / production
DEBUG=true
LOG_LEVEL=INFO
SERVER_PORT=8000
BASE_URL=http://localhost:8000

# ==================== 数据库 / 缓存 ====================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/storybook
REDIS_URL=redis://127.0.0.1:6379/0

# ==================== 对象存储 ====================
# 生产用真实 AWS S3；开源/自托管可指向 MinIO（S3 兼容）。
S3_BUCKET_NAME=your-bucket-name
CDN_DOMAIN=http://localhost:9000/your-bucket-name
# 仅当使用 MinIO 等 S3 兼容存储时设置以下三项（留空=真实 AWS S3 + IAM role）：
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# ==================== 任务队列 ====================
# 生产用真实 AWS SQS；开源/自托管可指向 elasticmq（SQS 兼容）。
SQS_QUEUE_URL=
SQS_ENDPOINT_URL=

# ==================== 媒体服务 ====================
MEDIA_SERVICE_URL=http://localhost:8080
DEEP_AGENT_V2_TASK_MAX_ATTEMPTS=3
DEEP_AGENT_V2_TASK_TIMEOUT_SECONDS=900
DEEP_AGENT_V2_TRANSCRIPTION_TIMEOUT_SECONDS=300
DEEP_AGENT_V2_PROVIDER_TIMEOUT_SECONDS=1800
DEEP_AGENT_V2_PROGRESS_INITIAL_SECONDS=20
DEEP_AGENT_V2_PROGRESS_INTERVAL_SECONDS=60
DEEP_AGENT_V2_RETRY_BASE_DELAY_SECONDS=2

# ==================== 鉴权 / 计费（开源自托管开关） ====================
JWT_SECRET_KEY=change-this-to-a-long-random-secret
CUTI_SERVICE_ENABLED=false
CUTI_SERVICE_TOKEN=
VIDEO_RUNTIME_ENVIRONMENT=development
VIDEO_RUNTIME_SERVICE_TOKEN=
VIDEO_RUNTIME_LOCAL_USER_ID=local-user
CUTI_SERVICE_DEFAULT_USER_ID=
# 免登录单用户模式：置 true 且填好 CUTI_SERVICE_DEFAULT_USER_ID 即可本地开箱即用
LOCAL_SINGLE_USER_MODE=true
# 自托管默认不计费；置 false 才启用积分扣费（需配套计费表/后端）
DISABLE_BILLING=true

# ==================== LLM / 第三方供应商（按需填写） ====================
OPENAI_API_KEY=
OPENAI_API_KEY_FALLBACK=
# Pixel-level isolation check for generated scene references. When omitted it
# follows OPENAI_API_KEY availability; set false only for offline development.
VIDEO_SCENE_REFERENCE_VISUAL_VALIDATION_ENABLED=
VIDEO_SCENE_REFERENCE_VALIDATOR_MODEL=gpt-5.6-terra
DEEP_AGENT_V2_ACTIVE_RUN_LIMIT_ENABLED=true
DEEP_AGENT_V2_MAX_ACTIVE_RUNS_PER_USER=1
# Subtitle transcription defaults to whisper-1 because it provides word and segment timestamps.
# Override only with a model that supports verbose timestamped transcription.
SUBTITLE_TRANSCRIPTION_MODEL=whisper-1
SUBTITLE_TRANSCRIPTION_MAX_BYTES=26214400
GOOGLE_API_KEY=
WAVESPEED_API_KEY=
SUNO_API_KEY=
POLLO_API_KEY=

# ==================== LangSmith 追踪（默认关闭，不外发数据） ====================
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=

# ==================== 合并单体 / 自托管开关 ====================
# 进程内挂载 Chat Router；开源 Monorepo 示例使用 DeepSeek 兼容 BFF。
ENABLE_CHAT_AGENT=true
# Chat 调核心的方式：local=进程内直调（合并单体）；http=跨进程委托（原行为）
WORKFLOW_CLIENT_MODE=http
# 挂载 ee/ 运营 admin 路由（开源自托管设 false；ee/ 不存在时自动跳过）
ENABLE_OPS_ADMIN=false
# 内置迷你前端：bundled=挂载到 /；headless=仅暴露 API（默认）
WEB_MODE=headless
# SQS 任务 Worker：无队列的自托管可设 false（不处理异步任务，避免启动报错/刷屏）
ENABLE_TASK_WORKER=false
# Video Agent uses DeepSeek for its only product Agent backend.
VIDEO_AGENT_BACKEND=deepseek
VIDEO_INCREMENTAL_ENGINE_ENABLED=true
VIDEO_STAGED_PLANNING_ENABLED=true
# Optional platform-separated roots replacing the complete built-in Skill catalog.
VIDEO_SKILL_PATHS=
DEEP_AGENT_V2_SUBAGENTS_ENABLED=true
DEEP_AGENT_V2_TRACE_ENABLED=true
DEEP_AGENT_V2_TRACE_LOG_PATH=logs/deep_agent_v2_trace.jsonl
# Max concurrent video-generation tasks per run (assemble/concat/edit excluded)
DEEP_AGENT_V2_MAX_PARALLEL_GENERATION_TASKS=2

# Studio dynamic task-graph beta. Keep false until a rollout environment is ready.
STUDIO_DYNAMIC_GRAPH_ENABLED=false
# Comma-separated user IDs. Empty means every user in a flagged environment.
STUDIO_DYNAMIC_GRAPH_ROLLOUT_USERS=

# ==================== Deep Agent V2 不可信 Skill 沙箱 ====================
# 仅在 sandbox-worker 可用时开启；关闭时 external sandbox skills 会注册为 disabled。
DEEP_AGENT_V2_SANDBOX_ENABLED=false
DEEP_AGENT_V2_SANDBOX_WORKER_URL=http://localhost:8090
DEEP_AGENT_V2_SANDBOX_TOKEN=
DEEP_AGENT_V2_SANDBOX_REQUEST_TIMEOUT_SECONDS=930
# Only these host variables are copied into Skill execution environments.
DEEP_AGENT_V2_SKILL_ENV_ALLOWLIST=ARK_API_KEY
# Optional Ed25519 keys: {"key-id":"base64-raw-public-key"}
DEEP_AGENT_V2_SKILL_SIGNING_KEYS_JSON={}

# ==================== Provider 后端开关（自托管：只需 Postgres + Redis） ====================
# 任务队列：redis=复用 Redis（无需 SQS） / sqs=AWS（默认）
QUEUE_BACKEND=redis
# 对象存储：local=本地文件（无需 S3/MinIO） / s3=AWS/MinIO（默认）
STORAGE_BACKEND=local
# LLM 账号 Key：env=读本文件里的各家 key（无需 AppConfig） / appconfig=AWS（默认）
ACCOUNT_BACKEND=env
# 本地存储落地目录 + 对外访问基址（STORAGE_BACKEND=local 时用；文件经 /files/* 暴露）
LOCAL_STORAGE_DIR=./data/uploads
PUBLIC_BASE_URL=http://127.0.0.1:8001

# ==================== 存储 / 队列 endpoint（仅 STORAGE/QUEUE_BACKEND 用兼容服务时才需要） ====================
# 指向 S3 兼容服务（MinIO）；STORAGE_BACKEND=s3 且用 MinIO 时填，否则留空
S3_ENDPOINT_URL=
# 指向 SQS 兼容服务（elasticmq）；QUEUE_BACKEND=sqs 且用 elasticmq 时填，否则留空
SQS_ENDPOINT_URL=

# ==================== Stage kit / LLM 档位（VideoAgent 阶段深代理） ====================
# LLM quality tier: best | common | economy（默认 best）
# LLM_QUALITY=best
# 阶段 artifact 落盘根目录（多副本需共享卷 / EFS）
STAGE_ARTIFACT_ROOT=data/run_workspaces

# ==================== 其它 ====================
STATIC_PHOTOS_DIR=./static/photos
DEEP_AGENT_V2_MODEL=gpt-5.6-terra
