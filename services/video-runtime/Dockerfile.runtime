FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/video-runtime

COPY services/video-runtime/requirements-runtime.txt ./requirements-runtime.txt
RUN pip install --no-cache-dir -r requirements-runtime.txt

COPY services/video-runtime/app ./app
COPY services/video-runtime/plugins ./plugins
COPY services/video-runtime/skills ./skills
COPY services/video-runtime/kit ./kit

ENV PYTHONPATH=/srv/video-runtime \
    VIDEO_RUNTIME_DATABASE_SCHEMA=cuti_video_runtime

EXPOSE 8001

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health')"

CMD ["uvicorn", "app.video_runtime.standalone:app", "--host", "0.0.0.0", "--port", "8001"]
