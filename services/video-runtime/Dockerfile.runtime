FROM python:3.11-slim

# OS libs: ffmpeg for media, libpq for Postgres. Python deps come from pyproject.toml.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libpq-dev \
        gcc \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/video-runtime

COPY services/video-runtime/pyproject.toml ./pyproject.toml
RUN pip config set global.timeout 120 \
    && pip config set global.retries 8 \
    && python -c "import tomllib, subprocess, sys; deps=tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; subprocess.check_call([sys.executable, '-m', 'pip', 'install', '--no-cache-dir', *deps])"

# Copy the service tree, not a hand-maintained folder list. PYTHONPATH is
# /srv/video-runtime, so first-party packages (app, prompts) and data
# (plugins, skills, kit) must live here. tests/helm/docs/ee/data are excluded
# via .dockerignore.
COPY services/video-runtime/ ./

ENV PYTHONPATH=/srv/video-runtime \
    VIDEO_RUNTIME_DATABASE_SCHEMA=cuti_video_runtime

EXPOSE 8001

HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/health')"

CMD ["uvicorn", "app.video_runtime.standalone:app", "--host", "0.0.0.0", "--port", "8001"]
