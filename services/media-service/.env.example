# ============================================================
# Cuti Media Service —— 环境变量示例
# 复制为 .env 后按需修改。开源自托管默认走 local 存储，无需任何 AWS 凭据。
# 注意：一键脚本 ../start.sh 会自动注入本地默认项并拉起本服务，
#       手动单独运行本服务时才需要此文件。
# ============================================================

# 运行
ENVIRONMENT=development
LOG_LEVEL=info
PORT=8080

# ---------- 存储后端（与 agent 项目保持一致的开关名）----------
# s3    ：云端对象存储（需配置下方 AWS_* / S3_*）
# local ：落地本地磁盘，自托管默认；须与 agent 共享同一 LOCAL_STORAGE_DIR，
#         产出 URL 形如 {PUBLIC_BASE_URL}/files/{key}，由 agent 的 /files 静态挂载对外提供
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=../../data/uploads
PUBLIC_BASE_URL=http://localhost:8000

# ---------- AWS S3（仅 STORAGE_BACKEND=s3 时需要；local 模式可全部留空）----------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-2
# S3_BUCKET=cuti-media
# S3_CDN_PREFIX=https://cdn.example.com
# S3_ENDPOINT_URL=            # S3 兼容存储（如 MinIO）自定义端点；留空走真实 AWS

# ---------- FFmpeg ----------
# FFMPEG_THREADS=2
# MAX_CONCURRENT_JOBS=3
# 字幕字体默认自动发现可显示中日韩文字的系统字体。自定义字体时同时设置字体族名和目录：
# SUBTITLE_FONT_NAME=Noto Sans CJK SC
# SUBTITLE_FONTS_DIR=/usr/share/fonts/opentype/noto
# 中间文件工作目录。容器内用 /workspace；本机手动运行请指向可写目录（一键脚本已自动处理）
WORKSPACE_BASE=./data/media-workspace
