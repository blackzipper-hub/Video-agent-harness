# Local single-user mode bypasses only the frontend login UI.
# Local compose / `pnpm dev`: true. Dev and harness-test Docker builds: false (Go login).
VITE_LOCAL_SINGLE_USER_MODE=true
VITE_LOCAL_SINGLE_USER_ID=00000000-0000-0000-0000-000000000001
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_CUTI_BACKEND_URL=http://127.0.0.1:8000
VITE_VIDEOCHAT_URL=http://127.0.0.1:8001
VITE_VIDEO_RUNTIME_URL=http://127.0.0.1:8001
VITE_API_BASE_URL=/api/v1
VITE_CUTI_VIDEO_API_BASE_URL=/api/cv-v1
VITE_BASE_PATH=/
VITE_MEDIA_CDN_ORIGIN=
