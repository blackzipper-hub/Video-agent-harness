# Copy this file to .env. Never commit real credentials.

# Required for DeepSeek conversation and VideoSpec planning.
OPENAI_API_KEY=

# Configure WAVESPEED_API_KEY or ARK_API_KEY for the default Seedance video path.
WAVESPEED_API_KEY=
ARK_API_KEY=

# Optional providers. They are needed only by workflows that use them.
SUNO_API_KEY=
GOOGLE_API_KEY=
POLLO_API_KEY=

# Optional network proxy. Leave blank when OpenAI and media providers are
# reachable directly. All local services inherit these values consistently.
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=127.0.0.1,localhost,postgres,video-runtime,media-service,sandbox-worker,deepseek-harness
NODE_USE_ENV_PROXY=1

# Local development defaults. Replace the grant secret in any shared deployment.
VIDEO_AGENT_MODEL=gpt-5.6-terra
VIDEO_RUNTIME_SERVICE_TOKEN=video-harness-runtime-local
VIDEO_CAPABILITY_GRANT_SECRET=video-harness-local-development-grant-secret
# Restore Cuti V2 semantics: DeepSeek submits one PlanPatch after each completed
# task frontier instead of precompiling the full production DAG.
VIDEO_STAGED_PLANNING_ENABLED=true
VIDEO_CONTINUOUS_PLAN_PATCH_ENABLED=true
